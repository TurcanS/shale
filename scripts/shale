#!/bin/sh
set -eu
config="$HOME/.config/quickshell/shale"
version() {
  v=
  [ -r "$config/VERSION" ] && read -r v < "$config/VERSION" || true
  case "$v" in ''|*[!0-9A-Za-z.+~-]*) v=unknown ;; esac
  echo "$v"
}
set -- "${1:-launcher}" "${2:-}"
case "$1" in
  start)
    # The whole session environment, so apps launched from Shale see PATH, $TERMINAL, themes and
    # cursors set in hyprland.lua, not just the variables a systemd user service starts with.
    dbus-update-activation-environment --systemd --all
    systemctl --user daemon-reload
    # Apps need a polkit agent to ask for passwords; start Hyprland's if no other agent runs.
    if systemctl --user cat hyprpolkitagent.service >/dev/null 2>&1 \
        && ! pgrep -f 'polkit-(gnome|kde|mate)|hyprpolkitagent|lxpolkit|polkit-agent' >/dev/null; then
      systemctl --user start hyprpolkitagent.service || true
    fi
    # Keep an existing idle policy, whether it runs as a process or as a (not yet started) service.
    if command -v hypridle >/dev/null && ! pgrep -x hypridle >/dev/null \
        && ! systemctl --user is-active --quiet hypridle.service && ! systemctl --user is-enabled --quiet hypridle.service 2>/dev/null; then
      hypridle --config "$HOME/.config/hypr/shale-hypridle.conf" >/dev/null 2>&1 &
    fi
    # A crash loop leaves the unit failed with its start limit hit, which would refuse this start.
    systemctl --user reset-failed shale.service 2>/dev/null || true
    exec systemctl --user start shale.service
    ;;
  run)
    # What shale.service runs. glvnd loads NVIDIA's EGL and GLX drivers as well as Mesa's, so on a hybrid
    # laptop the shell would carry about 50 MB of NVIDIA driver while drawing on the integrated GPU. Use
    # Mesa alone when the GPU Hyprland renders on is a Mesa one; never otherwise, where it would mean
    # software rendering. SHALE_CHILD_UNSET names what was set here, so apps the shell launches (prime-run,
    # games) don't inherit it: ShellState.launch() removes it again.
    sysfs=${SHALE_SYSFS:-/sys} vendors=${SHALE_EGL_VENDORS:-/usr/share/glvnd/egl_vendor.d}
    if [ -z "${__EGL_VENDOR_LIBRARY_FILENAMES:-}${__EGL_VENDOR_LIBRARY_DIRS:-}" ] \
        && [ -r "$vendors/10_nvidia.json" ] && [ -r "$vendors/50_mesa.json" ]; then
      # Hyprland renders on the first of AQ_DRM_DEVICES when it is set, otherwise on the boot GPU.
      card=
      if [ -n "${AQ_DRM_DEVICES:-}" ]; then
        node=$(readlink -f "${AQ_DRM_DEVICES%%:*}") || node=
        [ -n "$node" ] && card=$sysfs/class/drm/${node##*/}
      else
        for vga in "$sysfs"/class/drm/card*/device/boot_vga; do
          read -r boot < "$vga" 2>/dev/null || continue
          if [ "$boot" = 1 ]; then card=${vga%/device/boot_vga}; break; fi
        done
      fi
      driver=$(readlink -f "$card/device/driver" 2>/dev/null) || driver=
      case ${card:+${driver##*/}} in
        i915|xe|amdgpu|radeon|nouveau)
          export __EGL_VENDOR_LIBRARY_FILENAMES="$vendors/50_mesa.json" SHALE_CHILD_UNSET=__EGL_VENDOR_LIBRARY_FILENAMES
          if [ -z "${__GLX_VENDOR_LIBRARY_NAME:-}" ]; then
            export __GLX_VENDOR_LIBRARY_NAME=mesa SHALE_CHILD_UNSET="$SHALE_CHILD_UNSET __GLX_VENDOR_LIBRARY_NAME"
          fi
          ;;
      esac
    fi
    exec quickshell --path "$config" --no-duplicate
    ;;
  stop) exec systemctl --user stop shale.service ;;
  restart)
    # An update may have changed the unit.
    systemctl --user daemon-reload
    systemctl --user reset-failed shale.service 2>/dev/null || true
    exec systemctl --user restart shale.service
    ;;
  logs) exec journalctl --user -u shale.service -n 80 --no-pager ;;
  close) exec quickshell ipc -p "$config" call shell close ;;
  lock)
    exec "$config/scripts/session-action" lock
    ;;
  screenshot)
    case "${2:-region}" in
      region|output) exec quickshell ipc -p "$config" call shell action "screenshot-${2:-region}" ;;
      *) echo 'Usage: shale screenshot [region|output]' >&2; exit 2 ;;
    esac
    ;;
  page)
    case "$2" in
      wifi|bluetooth|audio|power|media|tray) exec quickshell ipc -p "$config" call shell page "$2" ;;
      *) echo 'Usage: shale page {wifi|bluetooth|audio|power|media|tray}' >&2; exit 2 ;;
    esac
    ;;
  color) exec quickshell ipc -p "$config" call shell action color ;;
  stop-recording) exec quickshell ipc -p "$config" call shell action stop-recording ;;
  status)
    state=$(quickshell ipc -p "$config" call shell status)
    case "$state" in
      '{}') printf '{"version":"%s"}\n' "$(version)" ;;
      '{'*) printf '{"version":"%s",%s\n' "$(version)" "${state#?}" ;;
      *) printf '%s\n' "$state" ;;
    esac
    ;;
  --version|version) echo "Shale $(version)" ;;
  launcher|clipboard|control|notifications|overview|settings|capture|power|calendar|wallpaper|activity|system)
    exec quickshell ipc -p "$config" call shell toggle "$1"
    ;;
  help|-h|--help) echo 'Usage: shale {start|stop|restart|logs|close|lock|launcher|clipboard|control|notifications|overview|settings|capture|power|calendar|wallpaper|activity|system|screenshot [region|output]|page PAGE|color|stop-recording|status|--version}' ;;
  *) echo 'Usage: shale {start|stop|restart|logs|close|lock|launcher|clipboard|control|notifications|overview|settings|capture|power|calendar|wallpaper|activity|system|screenshot [region|output]|page PAGE|color|stop-recording|status|--version}' >&2; exit 2 ;;
esac
