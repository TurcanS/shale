#!/bin/sh
set -eu
config="$HOME/.config/quickshell/shale"
version() {
  v=
  [ -r "$config/VERSION" ] && read -r v < "$config/VERSION" || true
  case "$v" in ''|*[!0-9A-Za-z.+~-]*) v=unknown ;; esac
  echo "$v"
}
set -- "${1:-launcher}" "${2:-}"
case "$1" in
  start)
    # The whole session environment, so apps launched from Shale see PATH, $TERMINAL, themes and
    # cursors set in hyprland.lua, not just the variables a systemd user service starts with.
    dbus-update-activation-environment --systemd --all
    systemctl --user daemon-reload
    # Apps need a polkit agent to ask for passwords; start Hyprland's if no other agent runs.
    if systemctl --user cat hyprpolkitagent.service >/dev/null 2>&1 \
        && ! pgrep -f 'polkit-(gnome|kde|mate)|hyprpolkitagent|lxpolkit|polkit-agent' >/dev/null; then
      systemctl --user start hyprpolkitagent.service || true
    fi
    # Keep an existing idle policy, whether it runs as a process or as a (not yet started) service.
    if command -v hypridle >/dev/null && ! pgrep -x hypridle >/dev/null \
        && ! systemctl --user is-active --quiet hypridle.service && ! systemctl --user is-enabled --quiet hypridle.service 2>/dev/null; then
      hypridle --config "$HOME/.config/hypr/shale-hypridle.conf" >/dev/null 2>&1 &
    fi
    # A crash loop leaves the unit failed with its start limit hit, which would refuse this start.
    systemctl --user reset-failed shale.service 2>/dev/null || true
    exec systemctl --user start shale.service
    ;;
  stop) exec systemctl --user stop shale.service ;;
  restart)
    # An update may have changed the unit.
    systemctl --user daemon-reload
    systemctl --user reset-failed shale.service 2>/dev/null || true
    exec systemctl --user restart shale.service
    ;;
  logs) exec journalctl --user -u shale.service -n 80 --no-pager ;;
  close) exec quickshell ipc -p "$config" call shell close ;;
  lock)
    exec "$config/scripts/session-action" lock
    ;;
  screenshot)
    case "${2:-region}" in
      region|output) exec quickshell ipc -p "$config" call shell action "screenshot-${2:-region}" ;;
      *) echo 'Usage: shale screenshot [region|output]' >&2; exit 2 ;;
    esac
    ;;
  page)
    case "$2" in
      wifi|bluetooth|audio|power|media|tray) exec quickshell ipc -p "$config" call shell page "$2" ;;
      *) echo 'Usage: shale page {wifi|bluetooth|audio|power|media|tray}' >&2; exit 2 ;;
    esac
    ;;
  color) exec quickshell ipc -p "$config" call shell action color ;;
  stop-recording) exec quickshell ipc -p "$config" call shell action stop-recording ;;
  status)
    state=$(quickshell ipc -p "$config" call shell status)
    case "$state" in
      '{}') printf '{"version":"%s"}\n' "$(version)" ;;
      '{'*) printf '{"version":"%s",%s\n' "$(version)" "${state#?}" ;;
      *) printf '%s\n' "$state" ;;
    esac
    ;;
  --version|version) echo "Shale $(version)" ;;
  launcher|clipboard|control|notifications|overview|settings|capture|power|calendar|wallpaper|activity)
    exec quickshell ipc -p "$config" call shell toggle "$1"
    ;;
  help|-h|--help) echo 'Usage: shale {start|stop|restart|logs|close|lock|launcher|clipboard|control|notifications|overview|settings|capture|power|calendar|wallpaper|activity|screenshot [region|output]|page PAGE|color|stop-recording|status|--version}' ;;
  *) echo 'Usage: shale {start|stop|restart|logs|close|lock|launcher|clipboard|control|notifications|overview|settings|capture|power|calendar|wallpaper|activity|screenshot [region|output]|page PAGE|color|stop-recording|status|--version}' >&2; exit 2 ;;
esac
